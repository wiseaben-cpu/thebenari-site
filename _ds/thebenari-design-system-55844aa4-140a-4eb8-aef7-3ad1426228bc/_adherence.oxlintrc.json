{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "slides/**",
              "ui_kits/portfolio-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Archivo Narrow))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Archivo Narrow."
      },
      {
        "selector": "JSXOpeningElement[name.name='BirdField'] > JSXAttribute > JSXIdentifier[name!=/^(?:bird|tone|size|drift|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<BirdField> doesn't accept that prop. Declared props: bird, tone, size, drift, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BirdField'] > JSXAttribute[name.name='bird'] > Literal[value!=/^(?:glide|land|climb)$/]",
        "message": "<BirdField> bird must be one of 'glide' | 'land' | 'climb'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BirdField'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ghost-paper|ghost-blue|blue|cream|ink)$/]",
        "message": "<BirdField> tone must be one of 'ghost-paper' | 'ghost-blue' | 'blue' | 'cream' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:flat|soft|inset|dark)$/]",
        "message": "<Card> variant must be one of 'flat' | 'soft' | 'inset' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Display'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|as|tone|align|children|style|key|ref|className|style|children)$/]",
        "message": "<Display> doesn't accept that prop. Declared props: level, as, tone, align, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Display'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|div|p)$/]",
        "message": "<Display> as must be one of 'h1' | 'h2' | 'h3' | 'div' | 'p'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Display'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|onDark|blue|cream)$/]",
        "message": "<Display> tone must be one of 'default' | 'onDark' | 'blue' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Display'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Display> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlockMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<FlockMark> doesn't accept that prop. Declared props: tone, size, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlockMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|cream|ink)$/]",
        "message": "<FlockMark> tone must be one of 'blue' | 'cream' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<MetaLabel> doesn't accept that prop. Declared props: index, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|strong|onDark|accent)$/]",
        "message": "<MetaLabel> tone must be one of 'muted' | 'strong' | 'onDark' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|category|year|image|imageAlt|index|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: title, category, year, image, imageAlt, index, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:weight|tone|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: weight, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:hair|heavy)$/]",
        "message": "<Rule> weight must be one of 'hair' | 'heavy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|onDark)$/]",
        "message": "<Rule> tone must be one of 'default' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|title|intro|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: index, label, title, intro, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|onDark|blue)$/]",
        "message": "<SectionHeading> tone must be one of 'default' | 'onDark' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:outline|solid|blue|inset)$/]",
        "message": "<Tag> tone must be one of 'outline' | 'solid' | 'blue' | 'inset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|rows|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, hint, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|tone|size|withMark|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: text, tone, size, withMark, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|cream|blue)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'cream' | 'blue'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
